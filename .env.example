# Agents One build-time configuration (optional)
# Set these in your build environment or CI to enable the corresponding feature.
# These values are NOT exposed to users and are only used in official builds.
#
# GITHUB SECRETS SETUP:
#   1. Go to Settings → Secrets and variables → Actions
#   2. Add repository secrets/variables
#   3. These are automatically injected during GitHub Actions builds.
#   4. Forks without these secrets will have the feature disabled.

# (No required environment variables for a default build.)

# LOCAL WEB PROVIDER EXPERIMENTS (unsupported; public default is off)
# This only makes the setting available. The user must still acknowledge the
# third-party data/account risk in the app before any provider can run.
# AGENTS_ONE_ENABLE_EXPERIMENTAL_WEB_AGENTS=1

# Local emergency override. This wins over a previously saved opt-in and stops
# Web Agent access without contacting a remote policy or telemetry service.
# AGENTS_ONE_DISABLE_WEB_AGENTS=1
